# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="your-32-character-session-secret-here"
NODE_ENV="development"

# --- SUPABASE CONFIG ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- WHATSAPP CONFIG ---
WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"
WHATSAPP_ACCESS_TOKEN="your-system-user-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-waba-id"

# --- META ADS ---
NEXT_PUBLIC_FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# --- RAZORPAY ---
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# --- UPSTASH / QSTASH ---
UPSTASH_REDIS_REST_URL="https://your-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# --- CRON / WORKER ---
# Protects the manual /api/cron/* triggers. The Railway worker does not need it.
CRON_SECRET="a-long-random-string"

# --- WORKER TUNING (optional; shown with defaults) ---
# Broadcast messages per second per number. Meta's default limit is 80.
BROADCAST_RATE_PER_SECOND=40
BROADCAST_CONCURRENCY=20
BROADCAST_PARALLEL=2
WEBHOOK_BATCH=50
WEBHOOK_CONCURRENCY=8

# --- TESTING WITH A SPECIFIC WHATSAPP ACCOUNT (e.g. Meta's free test account) ---
# Used by `npm run wa:check` / `wa:link`, and by the one-click "Use test account" button
# on the Connect page. That button is shown only to the emails listed in ADMIN_EMAILS.
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
ADMIN_EMAILS="you@example.com"
